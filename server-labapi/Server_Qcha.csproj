<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- LabAPI 插件统一目标框架：net48（游戏进程内 Mono 运行时） -->
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>12.0</LangVersion>
    <Platforms>AnyCPU</Platforms>
    <Nullable>disable</Nullable>

    <!-- 插件版本：LabAPI 默认用 Assembly.GetName().Version 作为插件版本，
         这里显式声明，需与 Main.cs 中的 Version 属性保持一致。 -->
    <Version>1.4.0</Version>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>

    <AssemblyName>Server_Qcha</AssemblyName>
    <RootNamespace>SocketServer</RootNamespace>

    <!-- 引用全部由游戏进程提供；禁止把 DLL 复制到输出目录，避免污染 LabAPI/plugins -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!--
      不生成 PDB。
      LabAPI 的加载器在 DLL 旁边发现 .pdb 时会走
      Assembly.Load(dllBytes, pdbBytes) 这条路径，而游戏内的 Mono 运行时
      对符号流支持很差，容易导致插件加载失败。
      需要调试时请单独打开此开关，并且只把 DLL 拷进 plugins 目录。
    -->
    <DebugType>none</DebugType>

    <!-- Set SCPSL_REFERENCES to SCPSL_Data/Managed in a local, licensed server installation. -->
    <ScpslReferences Condition="'$(ScpslReferences)' == ''">$(SCPSL_REFERENCES)</ScpslReferences>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Northwood.LabAPI" Version="1.1.7" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ScpslReferences)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CommandSystem.Core">
      <HintPath>$(ScpslReferences)\CommandSystem.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirror">
      <HintPath>$(ScpslReferences)\Mirror.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NorthwoodLib">
      <HintPath>$(ScpslReferences)\NorthwoodLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ScpslReferences)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ScpslReferences)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ScpslReferences)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>$(ScpslReferences)\UnityEngine.Physics2DModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
